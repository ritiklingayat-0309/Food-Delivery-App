// =======================
// About Us Page Localization - Marathi
// =======================
"about_us_text1_03" = "आमचे ध्येय म्हणजे वापरकर्त्यांना अखंड आणि सोपा खरेदीचा अनुभव देणे. आमच्या सोप्या इंटरफेस आणि विश्वासार्ह सेवेच्या मदतीने ब्राउझिंग, खरेदी आणि प्रॉडक्ट व्यवस्थापन सहजसोपे वाटेल.";
"about_us_text2_03" = "आम्ही उच्च कार्यक्षमता, पारदर्शकता आणि विश्वास कायम ठेवण्यासाठी कटिबद्ध आहोत. आमची टीम सतत अॅपची कार्यक्षमता वाढवण्यासाठी, डेटा प्रायव्हसी सुनिश्चित करण्यासाठी आणि ग्राहक सहाय्य देण्यासाठी कार्यरत असते.";
"about_us_text3_03" = "तुमचा अभिप्राय आमच्यासाठी महत्वाचा आहे. तुम्हाला काही प्रश्न, सूचना किंवा समस्या असल्यास आमच्याशी संपर्क साधा. आम्ही मदतीसाठी सदैव तयार आहोत.";
"about_us_text4_03" = "आम्ही मानतो की तंत्रज्ञानाने लोकांची सेवा करायला हवी. म्हणूनच आम्ही आमचे प्लॅटफॉर्म वापरकर्त्यांच्या गरजेनुसार सतत सुधारतो.";
"about_us_text5_03" = "सुरक्षितता आमची पहिली प्राथमिकता आहे. तुमची वैयक्तिक माहिती सुरक्षित ठेवण्यासाठी आम्ही उद्योगमान्य प्रोटोकॉल वापरतो.";
"about_us_text6_03" = "आम्ही सर्वांसाठी उपलब्धता आणि समावेशकतेला महत्त्व देतो. आमचे प्लॅटफॉर्म सर्व पार्श्वभूमी, डिव्हाइस आणि तांत्रिक क्षमतांच्या लोकांना वापरता येईल अशा पद्धतीने डिझाइन केले आहे.";
"about_us_text7_03" = "शाश्वतता आमच्यासाठी महत्त्वाची आहे. आम्ही पर्यावरणपूरक पद्धतींना समर्थन देतो आणि पर्यावरणावर परिणाम कमी करण्यासाठी प्रयत्न करतो.";

