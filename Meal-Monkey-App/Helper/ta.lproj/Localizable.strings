// About Us Page Localization - Tamil
// =======================
"about_us_text1_03" = "எங்கள் நோக்கம் பயனர்களுக்கு எளிய மற்றும் சுலபமான வணிக அனுபவத்தை வழங்குவது. உலாவல், கொள்முதல் மற்றும் பொருட்களை நிர்வகித்தல் எளிதாக இருக்க வேண்டும்.";
"about_us_text2_03" = "உயர்தர செயல்திறன், வெளிப்படைத் தன்மை மற்றும் நம்பகத்தன்மையை பராமரிக்க நாங்கள் அர்ப்பணிக்கப்பட்டுள்ளோம். எங்கள் குழு எப்போதும் பயன்பாட்டை மேம்படுத்துகிறது.";
"about_us_text3_03" = "உங்கள் கருத்துக்கள் எங்களுக்கு முக்கியம். கேள்விகள் அல்லது பிரச்சினைகள் இருந்தால் எங்களை தொடர்பு கொள்ளுங்கள்.";
"about_us_text4_03" = "தொழில்நுட்பம் மக்களுக்கு உதவ வேண்டும் என்று நாங்கள் நம்புகிறோம். அதனால் பயனர் தேவைகளை அடிப்படையாகக் கொண்டு எங்கள் தளத்தை மேம்படுத்துகிறோம்.";
"about_us_text5_03" = "பாதுகாப்பு எங்கள் முன்னுரிமை. உங்கள் தனிப்பட்ட தரவை பாதுகாக்க நாங்கள் தொழில்துறை தரநிலைகளைப் பயன்படுத்துகிறோம்.";
"about_us_text6_03" = "அனைவருக்கும் பயன்படும் வகையில் எங்கள் தளம் வடிவமைக்கப்பட்டுள்ளது.";
"about_us_text7_03" = "நிலைத்தன்மை எங்களுக்கு முக்கியம். பசுமையான வணிகத்தை ஆதரிக்கிறோம்.";

