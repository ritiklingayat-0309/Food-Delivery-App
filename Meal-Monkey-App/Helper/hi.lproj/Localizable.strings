// =======================
// About Us Page Localization - Hindi
// =======================
"about_us_text1_03" = "हमारा मिशन एक सहज और सरल शॉपिंग अनुभव प्रदान करना है जो उपयोगकर्ता संतुष्टि को प्राथमिकता देता है। हमारा उद्देश्य एक ऐसा प्लेटफ़ॉर्म बनाना है जहाँ ब्राउज़िंग, खरीदारी और उत्पादों का प्रबंधन आसान और तेज़ हो।";
"about_us_text2_03" = "हम उच्च प्रदर्शन, पारदर्शिता और विश्वास के मानकों को बनाए रखने के लिए प्रतिबद्ध हैं। हमारी टीम लगातार ऐप की कार्यक्षमता को बेहतर बनाने, डेटा सुरक्षा सुनिश्चित करने और उत्तरदायी ग्राहक सहायता प्रदान करने पर काम कर रही है।";
"about_us_text3_03" = "आपकी प्रतिक्रिया महत्वपूर्ण है। यदि आपके कोई प्रश्न, सुझाव या समस्याएँ हैं, तो हम मदद करने के लिए यहाँ हैं। हमारी सपोर्ट पेज या ईमेल के माध्यम से हमसे संपर्क करें।";
"about_us_text4_03" = "हम मानते हैं कि तकनीक को लोगों की सेवा करनी चाहिए। इसलिए हम लगातार उपयोगकर्ता व्यवहार और ज़रूरतों के आधार पर अपने प्लेटफ़ॉर्म को बेहतर बनाते रहते हैं।";
"about_us_text5_03" = "सुरक्षा हमारी प्राथमिकता है। हम आपके व्यक्तिगत डेटा की सुरक्षा के लिए उद्योग मानक प्रोटोकॉल का उपयोग करते हैं।";
"about_us_text6_03" = "हम पहुँच और समावेशिता को महत्व देते हैं। हमारा प्लेटफ़ॉर्म हर प्रकार के उपयोगकर्ताओं के लिए उपयोगी बनाया गया है।";
"about_us_text7_03" = "सततता हमारे लिए महत्वपूर्ण है। हम पर्यावरण-अनुकूल व्यावसायिक प्रथाओं का समर्थन करते हैं।";

